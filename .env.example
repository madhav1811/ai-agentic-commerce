# Razorpay test-mode keys — https://dashboard.razorpay.com/app/keys (toggle "Test Mode")
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# buyer agent's LLM — 100% free and local via Ollama (https://ollama.com), no API key needed.
# Install: `brew install ollama` (or see ollama.com/download), then:
#   ollama serve                       # starts the local server (or it's already a background service)
#   ollama pull qwen2.5:7b-instruct    # one-time ~4.7GB download, needs a model with tool-calling support
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# catalog-server
PORT=4000
# "simulated" runs fully unattended end-to-end with no browser (default, best for demos/CI).
# "real_payment_link" issues a real Razorpay test-mode payment link a human can actually pay
# with a published Razorpay test card, to see genuine capture instead of a simulated one.
PAYMENT_MODE=simulated
# Shared secret only the merchant operator holds — the buyer agent's tools never see this,
# so it cannot approve its own gated checkout.
APPROVAL_TOKEN=demo-approver-token

# buyer-agent
CATALOG_SERVER_URL=http://localhost:4000
# false = the operator gate prompts interactively on stdin instead of auto-approving.
AUTO_APPROVE=true
